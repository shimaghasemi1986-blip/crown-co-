// =========================
// MOBILE MENU
// =========================

const menuToggle = document.getElementById("menuToggle");
const nav = document.getElementById("nav");

menuToggle.addEventListener("click", () => {
  nav.classList.toggle("active");

  menuToggle.textContent =
    nav.classList.contains("active") ? "✕" : "☰";
});


// Close mobile menu when a link is clicked

document.querySelectorAll("nav a").forEach(link => {
  link.addEventListener("click", () => {
    nav.classList.remove("active");
    menuToggle.textContent = "☰";
  });
});


// =========================
// BOOKING FORM
// =========================

const bookingForm = document.getElementById("bookingForm");
const formMessage = document.getElementById("formMessage");

bookingForm.addEventListener("submit", function (event) {

  event.preventDefault();

  const name = document.getElementById("name").value;
  const style = document.getElementById("style").value;

  formMessage.textContent =
    `Thanks ${name}! Your ${style} request has been received. 👑`;

  bookingForm.reset();
});


// =========================
// SCROLL REVEAL
// =========================

const revealElements = document.querySelectorAll(
  ".service-card, .gallery-item, .about-content, .about-image"
);

const revealObserver = new IntersectionObserver(
  entries => {

    entries.forEach(entry => {

      if (entry.isIntersecting) {
        entry.target.classList.add("show");
      }

    });

  },
  {
    threshold: 0.15
  }
);

revealElements.forEach(element => {
  element.classList.add("reveal");
  revealObserver.observe(element);
});


// =========================
// IMAGE LIGHTBOX
// =========================

const galleryImages =
  document.querySelectorAll(".gallery-item img");

galleryImages.forEach(image => {

  image.addEventListener("click", () => {

    const overlay = document.createElement("div");

    overlay.className = "lightbox";

    overlay.innerHTML = `
      <button class="close-lightbox">×</button>
      <img src="${image.src}" alt="${image.alt}">
    `;

    document.body.appendChild(overlay);

    overlay.addEventListener("click", event => {

      if (
        event.target === overlay ||
        event.target.classList.contains("close-lightbox")
      ) {
        overlay.remove();
      }

    });

  });

});


:root {
  --black: #050505;
  --dark: #0c0c0c;
  --pink: #ff1493;
  --hot-pink: #ff2aa3;
  --light-pink: #ff8bd2;
  --white: #ffffff;
  --grey: #a7a7a7;

  --font-display: "Playfair Display", serif;
  --font-body: "DM Sans", sans-serif;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--black);
  color: var(--white);
  font-family: var(--font-body);
  overflow-x: hidden;
}

img {
  width: 100%;
  display: block;
  object-fit: cover;
}

a {
  color: inherit;
  text-decoration: none;
}


/* ================= NAV ================= */

.navbar {
  height: 82px;
  padding: 0 6%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: fixed;
  width: 100%;
  top: 0;
  z-index: 1000;

  background: rgba(5, 5, 5, 0.82);
  backdrop-filter: blur(15px);
  border-bottom: 1px solid rgba(255, 20, 147, 0.15);
}

.logo {
  font-size: 1.5rem;
  font-weight: 800;
  letter-spacing: -1px;
}

.logo span {
  color: var(--pink);
  margin: 0 3px;
}

nav {
  display: flex;
  gap: 35px;
}

nav a {
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  transition: 0.3s;
}

nav a:hover {
  color: var(--pink);
}

.nav-btn {
  padding: 13px 24px;
  background: var(--pink);
  color: #000;
  font-weight: 800;
  text-transform: uppercase;
  font-size: 0.75rem;
  letter-spacing: 1px;
  transition: 0.3s;
}

.nav-btn:hover {
  background: white;
  box-shadow: 0 0 30px rgba(255, 20, 147, 0.6);
}

.menu-toggle {
  display: none;
  background: none;
  border: none;
  color: white;
  font-size: 25px;
}


/* ================= HERO ================= */

.hero {
  min-height: 100vh;
  padding: 130px 7% 70px;

  display: grid;
  grid-template-columns: 1fr 0.85fr;
  align-items: center;
  gap: 60px;

  background:
    radial-gradient(
      circle at 75% 45%,
      rgba(255, 20, 147, 0.18),
      transparent 30%
    );
}

.eyebrow {
  color: var(--pink);
  font-size: 0.72rem;
  letter-spacing: 4px;
  font-weight: 800;
  margin-bottom: 18px;
}

h1,
h2 {
  font-family: var(--font-display);
  line-height: 0.95;
}

h1 {
  font-size: clamp(4rem, 7vw, 7.5rem);
  max-width: 850px;
}

h1 span,
h2 span {
  color: var(--pink);
  display: block;
}

.hero-text {
  max-width: 500px;
  color: var(--grey);
  line-height: 1.7;
  margin: 30px 0;
  font-size: 1.05rem;
}

.hero-buttons {
  display: flex;
  gap: 15px;
}

.btn {
  display: inline-block;
  padding: 17px 30px;
  border: 1px solid var(--pink);
  font-weight: 800;
  text-transform: uppercase;
  font-size: 0.75rem;
  letter-spacing: 1px;
  transition: 0.3s;
  cursor: pointer;
}

.btn.primary {
  background: var(--pink);
  color: #000;
}

.btn.primary:hover {
  background: white;
  border-color: white;
  transform: translateY(-3px);
}

.btn.secondary:hover {
  background: var(--pink);
  color: #000;
}

.hero-image {
  position: relative;
  max-width: 560px;
  justify-self: end;
}

.hero-image img {
  height: 700px;
  position: relative;
  z-index: 2;
  filter: grayscale(15%);
}

.pink-glow {
  position: absolute;
  width: 80%;
  height: 80%;
  background: var(--pink);
  filter: blur(100px);
  opacity: 0.28;
  top: 10%;
  left: 10%;
}

.hero-badge {
  position: absolute;
  z-index: 3;
  bottom: 30px;
  left: -35px;

  width: 125px;
  height: 125px;
  border-radius: 50%;

  background: var(--pink);
  color: #000;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  text-align: center;
  transform: rotate(-12deg);
}

.hero-badge strong {
  font-size: 1.5rem;
}

.hero-badge span {
  font-size: 0.6rem;
  font-weight: 800;
  letter-spacing: 1px;
}


/* ================= MARQUEE ================= */

.marquee {
  background: var(--pink);
  color: #000;
  padding: 16px 0;
  overflow: hidden;
  white-space: nowrap;
  font-weight: 900;
  letter-spacing: 3px;
}

.marquee div {
  animation: marquee 18s linear infinite;
}

@keyframes marquee {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-50%);
  }
}


/* ================= SECTIONS ================= */

.section {
  padding: 130px 7%;
}

.section-heading {
  max-width: 700px;
  margin-bottom: 65px;
}

.section-heading h2,
.about h2,
.booking h2 {
  font-size: clamp(3rem, 6vw, 6rem);
  margin-bottom: 25px;
}

.section-heading > p:last-child,
.booking > div > p:last-child {
  color: var(--grey);
  line-height: 1.7;
  max-width: 550px;
}


/* ================= SERVICES ================= */

.services-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2px;
}

.service-card {
  background: #0c0c0c;
  min-height: 350px;
  padding: 35px;

  position: relative;
  border: 1px solid #1d1d1d;

  transition: 0.4s;
}

.service-card:hover {
  background: var(--pink);
  color: #000;
  transform: translateY(-10px);
}

.service-card:hover p {
  color: #222;
}

.service-card.featured {
  background: var(--pink);
  color: #000;
}

.service-number {
  position: absolute;
  top: 25px;
  right: 25px;
  font-size: 0.7rem;
  opacity: 0.5;
}

.service-icon {
  font-size: 3rem;
  margin: 50px 0 25px;
}

.service-card h3 {
  font-size: 1.4rem;
  margin-bottom: 15px;
}

.service-card p {
  color: var(--grey);
  line-height: 1.6;
  margin-bottom: 25px;
}

.service-card strong {
  font-size: 0.8rem;
}


/* ================= GALLERY ================= */

.gallery-section {
  padding: 130px 7%;
  background: #080808;
}

.gallery {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-auto-rows: 300px;
  gap: 15px;
}

.gallery-item {
  position: relative;
  overflow: hidden;
}

.gallery-item.large {
  grid-row: span 2;
}

.gallery-item.wide {
  grid-column: span 2;
}

.gallery-item img {
  height: 100%;
  transition: 0.6s;
}

.gallery-item:hover img {
  transform: scale(1.08);
}

.gallery-overlay {
  position: absolute;
  inset: auto 20px 20px;
}

.gallery-overlay span {
  display: inline-block;
  padding: 9px 15px;
  background: var(--pink);
  color: #000;
  font-size: 0.7rem;
  text-transform: uppercase;
  font-weight: 800;
}


/* ================= ABOUT ================= */

.about {
  display: grid;
  grid-template-columns: 0.8fr 1fr;
  gap: 90px;
  align-items: center;
}

.about-image {
  position: relative;
}

.about-image::after {
  content: "";
  position: absolute;
  width: 100%;
  height: 100%;
  border: 2px solid var(--pink);
  top: 20px;
  left: 20px;
  z-index: -1;
}

.about-image img {
  height: 650px;
}

.about-content > p {
  color: var(--grey);
  line-height: 1.8;
  margin-bottom: 20px;
  max-width: 600px;
}

.stats {
  display: flex;
  gap: 50px;
  margin-top: 45px;
}

.stats div {
  display: flex;
  flex-direction: column;
}

.stats strong {
  color: var(--pink);
  font-size: 2rem;
}

.stats span {
  color: var(--grey);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 1px;
}


/* ================= TESTIMONIAL ================= */

.testimonial {
  padding: 140px 10%;
  text-align: center;

  background:
    linear-gradient(
      rgba(255, 20, 147, 0.92),
      rgba(255, 20, 147, 0.92)
    ),
    url("images/braids-3.jpg") center/cover;
  color: #000;
}

.quote-mark {
  font-family: Georgia, serif;
  font-size: 7rem;
  line-height: 0.5;
}

blockquote {
  font-family: var(--font-display);
  font-size: clamp(2.3rem, 5vw, 5rem);
  max-width: 1000px;
  margin: 40px auto;
  line-height: 1;
}

.testimonial p {
  font-weight: 800;
  font-size: 0.75rem;
  letter-spacing: 3px;
}


/* ================= BOOKING ================= */

.booking {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
}

.booking form {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.input-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}

input,
select,
textarea {
  width: 100%;
  background: #0d0d0d;
  color: white;
  border: 1px solid #292929;
  padding: 18px;
  font-family: inherit;
  outline: none;
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--pink);
}

textarea {
  resize: vertical;
}

#formMessage {
  color: var(--pink);
  font-weight: 700;
}


/* ================= FOOTER ================= */

footer {
  border-top: 1px solid #222;
  padding: 70px 7% 30px;

  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 50px;
}

.footer-brand p {
  color: var(--grey);
  margin-top: 15px;
}

.footer-links,
.socials {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.footer-links a:hover,
.socials a:hover {
  color: var(--pink);
}

.socials a {
  font-weight: 800;
}

.copyright {
  grid-column: 1 / -1;
  border-top: 1px solid #222;
  padding-top: 25px;
  color: #666;
  font-size: 0.75rem;
}


/* ================= MOBILE ================= */

@media (max-width: 900px) {

  nav {
    display: none;

    position: absolute;
    top: 82px;
    left: 0;
    width: 100%;
    background: #080808;
    flex-direction: column;
    padding: 30px;
  }

  nav.active {
    display: flex;
  }

  .nav-btn {
    display: none;
  }

  .menu-toggle {
    display: block;
  }

  .hero {
    grid-template-columns: 1fr;
    padding-top: 140px;
  }

  .hero-image {
    justify-self: center;
    width: 100%;
  }

  .hero-image img {
    height: 550px;
  }

  .services-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .about,
  .booking {
    grid-template-columns: 1fr;
  }

  .gallery {
    grid-template-columns: 1fr 1fr;
  }

  .gallery-item.wide {
    grid-column: span 2;
  }

  footer {
    grid-template-columns: 1fr 1fr;
  }
}


@media (max-width: 600px) {

  .navbar {
    padding: 0 5%;
  }

  .hero {
    padding-left: 5%;
    padding-right: 5%;
  }

  h1 {
    font-size: 3.6rem;
  }

  .hero-buttons {
    flex-direction: column;
  }

  .btn {
    text-align: center;
  }

  .services-grid {
    grid-template-columns: 1fr;
  }

  .gallery {
    grid-template-columns: 1fr;
    grid-auto-rows: 350px;
  }

  .gallery-item.large {
    grid-row: span 1;
  }

  .gallery-item.wide {
    grid-column: span 1;
  }

  .about-image img {
    height: 450px;
  }

  .stats {
    gap: 20px;
  }

  .stats strong {
    font-size: 1.5rem;
  }

  .input-row {
    grid-template-columns: 1fr;
  }

  footer {
    grid-template-columns: 1fr;
  }

